; The serialize.goose roadmap: the data ROADMAP.md is generated from, in the shape of
; mas-bandwidth/schema's docs/roadmap.sexp (one restricted S-expression; data, never evaluated).
; ROADMAP.md is rendered by tools/roadmap/render.lisp (vendored from mas-bandwidth/schema
; tools/roadmap at 609d4e032aff3323e4ee3a3495a1c86d56720914): edit this file, then `make roadmap`; `make roadmap-check`
; fails when the committed page is not what this data renders. Never edit ROADMAP.md by hand.
;
; A cell is ✅ only when every task under it is :done, and a :done task names its evidence (the
; commit that landed it, with the source data that records it). Every ❌ task names what is
; still outstanding, with any partial work recorded in the source data.
(:schema 1 :root "port/roadmap"
 :page (:title "serialize.goose roadmap"
        :roadmaps ("port")
        :closing ((:title "About this page" :text ("Each table lists the features of one area: ✅ is built, tested and landed, with the evidence in the source data; ❌ is not yet. The open rows are not yet built; each one records what remains in the source data, so the work can be picked up again."))))
 :nodes
 ((:id "port/roadmap" :type :work-set :children ("port"))
  (:id "port" :type :roadmap :title "The Goose port of serialize"
   :text ("The Goose port of serialize, the open-source bitpacking serializer: the same wire as serialize.c, byte for byte, with the same refusals. The families and the conformance runner are on main (PR #2, PR #3, 2026-10-22); format 2.0 landed with PR #5 (2026-10-22); the reference 2.1.0 standard, the rejected reason and the uniform rules U1-U16 landed with PR #10 (2026-10-27); the 2.1.1 rulings (one write-misuse trap, measure checks, copy_string, exports) landed with PR #11 (2026-10-27).")
   :rows
   (("design" "Design, family stubs and test runner")
    ("standard" "STANDARD.md matches serialize v2.1.4")
    ("uniform" "The rejected reason and the uniform rules U1 to U16")
    ("rulings" "The 2.1.1 rulings: one write-misuse trap (U9), measure checks (U6), copy_string and exports (U15)")
    ("format2" "Format 2.0: refusal reasons, finite floats, end, canonical int_relative")
    ("ci" "CI workflow and its invariant test")
    ("bitpacker" "64-bit bitpacker and window reader")
    ("integers" "Ranged integers, int64, int128, uint128 and relative ints")
    ("floats" "float, double, fixed and compressed floats")
    ("strings" "Bytes, strings, align and objects")
    ("conformance" "Whole conformance corpus, byte for byte with serialize.c")
    ("witnesses" "Reversed witnesses: each deleted refusal rule turns the suite red")
    ("controls" "Negative controls: each deleted rule fails exactly its conformance-controls list")
    ("fuzz" "Differential fuzzing against serialize.c")
    ("bench" "Benchmark against serialize.c, C++ serialize and serialize.rs")
    ("bench-report" "Goose vs C++ vs Rust (and Lobster) benchmark report"))
   :columns (("goose" "goose"))
   :cells
   (("design" "goose" "port/design")
    ("standard" "goose" "port/standard")
